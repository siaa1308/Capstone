# Generate each value with: openssl rand -hex 32
# The central VM needs all four variables below.
FCL_CENTRAL_SECRET=replace_with_at_least_32_random_characters
FCL_CLIENT_SECRET_BANK_1=replace_with_at_least_32_random_characters
FCL_CLIENT_SECRET_BANK_2=replace_with_at_least_32_random_characters
FCL_CLIENT_SECRET_BANK_3=replace_with_at_least_32_random_characters

# A bank VM needs FCL_CENTRAL_SECRET plus only its own secret, renamed:
# FCL_CLIENT_SECRET=<the matching BANK_N value>
